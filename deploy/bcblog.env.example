# 复制到 /etc/bcblog/bcblog.env 后改成真实值，并执行：
#   chmod 600 /etc/bcblog/bcblog.env

SERVER_PORT=8080

DB_URL=jdbc:mysql://127.0.0.1:3306/bc_blog?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=bcblog
DB_PASSWORD=change_me

BCBLOG_UPLOAD_DIR=/data/bcblog/uploads
BCBLOG_LOG_FILE=/data/bcblog/logs/bcblog.log

# 可选：追加敏感词，英文逗号分隔
BCBLOG_SENSITIVE_WORDS=
