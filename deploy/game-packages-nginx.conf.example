# Add INSIDE the existing beicheng.cloud server block before the generic /api/ location.
# Keep existing SSL, frontend, /api/, /uploads/ and other configuration unchanged.
# /api/admin/game-packages/sessions/*/complete can take longer while merging/hashing.
# Exact collection routes prevent Nginx's automatic trailing-slash redirects.
location = /api/admin/game-packages {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location = /api/portal/game-packages {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location ^~ /api/admin/game-packages/ {
    client_max_body_size 24M;
    client_body_timeout 300s;
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 600s;
    proxy_send_timeout 300s;
    proxy_request_buffering off;
}
location ^~ /api/portal/game-packages/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_read_timeout 600s;
    send_timeout 300s;
}
